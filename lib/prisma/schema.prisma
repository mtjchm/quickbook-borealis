
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}


model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  phone        String?
  passwordHash String   @map("password_hash")
  role         String   @default("customer") @map("role")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // company ownership (ownerId on Company)
  ownedCompanies Company[] @relation("CompanyOwner")

  // bookings where this user is the customer
  bookings       Booking[] @relation("CustomerBooking")

  // provider -> belongs to a company (nullable)
  company   Company? @relation("CompanyProviders", fields: [companyId], references: [id])
  companyId Int?     @map("company_id")

  @@map("users")
}

model Company {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  headerImageUrl   String?  @map("header_image_url")
  ownerId          Int      @map("owner_id")
  owner            User     @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  address          String?
  phone            String?
  email            String?
  businessHours    String?    @map("business_hours") // will be json string
  serviceName      String?  @map("service_name")
  serviceDescription String? @map("service_description")
  durationMinutes  Int?     @map("duration_minutes")
  price            Decimal? @db.Decimal(10, 2)
  isActive         Boolean  @map("is_active") @default(true)

  // providers/employees for this company
  providers User[]  @relation("CompanyProviders")
  Bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model Booking {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  customer      User     @relation("CustomerBooking", fields: [customerId], references: [id])
  companyId     Int      @map("company_id")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookingDate   DateTime @map("booking_date")
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  status        String   @map("status")
  customerNotes String?  @map("customer_notes")
  providerNotes String?  @map("provider_notes")
  totalPrice    Decimal? @map("total_price") @db.Decimal(10, 2)
  emailSent     Boolean  @map("email_sent") @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bookings")
}
